// Automatically generated by home-manager from `wayland.windowManager.niri`
input {
	mod-key "Super"
	mod-key-nested "Super"
	keyboard {
		xkb {
			layout "us"
		}
		numlock
	}
	mouse {
		accel-profile "flat"
		accel-speed 0.1
	}
	touchpad {
		tap
		natural-scroll
		dwt
	}
}
output "eDP-1" {
	position x=0 y=0
	scale 1
}
output "HDMI-A-1" {
	mode "1920x1080"
	position x=1920 y=0
	variable-refresh-rate
}
gestures {
	hot-corners {
		bottom-right
	}
}
workspace "browser" {
	open-on-output "HDMI-A-1"
}
workspace "coding" {
	open-on-output "HDMI-A-1"
}
workspace "herdr" {
	open-on-output "HDMI-A-1"
}
workspace "extra" {
	open-on-output "HDMI-A-1"
}
workspace "social" {
	open-on-output "eDP-1"
}
workspace "music" {
	open-on-output "eDP-1"
}
layout {
	gaps 16
	center-focused-column "never"
	preset-column-widths {
		proportion 0.333330
		proportion 0.500000
		proportion 0.666670
	}
	default-column-width {
		proportion 0.500000
	}
	focus-ring {
		width 2
		active-color "#7aa2f7"
		inactive-color "#565f89"
	}
	border {
		off
		width 2
		active-color "#e0af68"
		inactive-color "#565f89"
		urgent-color "#f7768e"
	}
	shadow {
		softness 30
		spread 5
		offset x=0 y=5
		color "#0007"
	}
}
spawn-at-startup "noctalia"
spawn-at-startup "bash" "-c" "~/.config/niri/scripts/workspace-owner.sh"
hotkey-overlay {
	skip-at-startup
}
prefer-no-csd
debug {
	honor-xdg-activation-with-invalid-serial
}
environment {
	QT_QPA_PLATFORM "wayland"
	XDG_CURRENT_DESKTOP "niri"
	XDG_SESSION_TYPE "wayland"
}
screenshot-path "/home/piioni/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
window-rule {
	match app-id="(zed|Zed|dev\\.zed\\.Zed)$"
	open-on-workspace "coding"
}
window-rule {
	match app-id="^herdr-app$"
	open-on-workspace "herdr"
}
window-rule {
	match app-id="(helium|Helium|google-chrome)$"
	open-on-workspace "browser"
}
window-rule {
	match app-id="(tidal-hifi)$"
	open-on-workspace "music"
}
window-rule {
	match app-id="(vesktop|dev\\.vesktop\\.Vesktop|signal|signal-desktop|teams-for-linux)$"
	open-on-workspace "social"
}
window-rule {
	match app-id="ghostty"
	opacity 0.900000
}
window-rule {
	match title="^Picture[- ]in[- ][Pp]icture$"
	open-floating true
}
window-rule {
	geometry-corner-radius 20
	clip-to-geometry true
}
binds {
	Alt+Shift+Slash {
		show-hotkey-overlay
	}
	Ctrl+Alt+Delete {
		quit
	}
	Mod+1 {
		focus-workspace "browser"
	}
	Mod+2 {
		focus-workspace "coding"
	}
	Mod+3 {
		focus-workspace "herdr"
	}
	Mod+4 {
		focus-workspace "extra"
	}
	Mod+5 {
		focus-workspace "social"
	}
	Mod+6 {
		focus-workspace "music"
	}
	Mod+7 {
		focus-workspace 7
	}
	Mod+8 {
		focus-workspace 8
	}
	Mod+9 {
		focus-workspace 9
	}
	Mod+B hotkey-overlay-title="Open the browser" {
		spawn "helium"
	}
	Mod+BracketLeft {
		consume-or-expel-window-left
	}
	Mod+BracketRight {
		consume-or-expel-window-right
	}
	Mod+C hotkey-overlay-title="Open Noctalia control center" {
		spawn "noctalia" "msg" "panel-toggle" "control-center"
	}
	Mod+Alt+C {
		center-column
	}
	Mod+Comma {
		consume-window-into-column
	}
	Mod+Ctrl+C {
		center-visible-columns
	}
	Mod+Shift+Down {
		move-window-down
	}
	Mod+Ctrl+End {
		move-column-to-last
	}
	Mod+Ctrl+F {
		expand-column-to-available-width
	}
	Mod+Shift+H {
		move-column-left
	}
	Mod+Ctrl+Home {
		move-column-to-first
	}
	Mod+Shift+I {
		move-workspace-up
	}
	Mod+Shift+J {
		move-column-to-workspace-down
	}
	Mod+Shift+K {
		move-column-to-workspace-up
	}
	Mod+Shift+L {
		move-column-right
	}
	Mod+Shift+Left {
		move-column-left
	}
	Mod+Shift+R hotkey-overlay-title="Toggle screen recording (region)" {
		spawn "/home/piioni/.config/niri/scripts/record-region.sh"
	}
	Mod+Shift+S hotkey-overlay-title="Screenshot region and annotate (Noctalia)" {
		spawn "noctalia" "msg" "screenshot-region" "--annotate" "--no-confirm-region"
	}
	Mod+Ctrl+Page_Down {
		move-column-to-workspace-down
	}
	Mod+Ctrl+Page_Up {
		move-column-to-workspace-up
	}
	Mod+Ctrl+R {
		reset-window-height
	}
	Mod+Shift+Right {
		move-column-right
	}
	Mod+Ctrl+Shift+WheelScrollDown {
		move-column-right
	}
	Mod+Ctrl+Shift+WheelScrollUp {
		move-column-left
	}
	Mod+Shift+U {
		move-workspace-down
	}
	Mod+Shift+Up {
		move-window-up
	}
	Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
		move-column-to-workspace-down
	}
	Mod+Ctrl+WheelScrollLeft {
		move-column-left
	}
	Mod+Ctrl+WheelScrollRight {
		move-column-right
	}
	Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
		move-column-to-workspace-up
	}
	Mod+Down {
		focus-window-down
	}
	Mod+E hotkey-overlay-title="Open the file manager" {
		spawn "nautilus"
	}
	Mod+End {
		focus-column-last
	}
	Mod+Equal {
		set-column-width "+10%"
	}
	Mod+Escape allow-inhibiting=false {
		toggle-keyboard-shortcuts-inhibit
	}
	Mod+F {
		maximize-column
	}
	Mod+H {
		focus-column-left
	}
	Mod+Home {
		focus-column-first
	}
	Mod+I {
		focus-workspace-up
	}
	Mod+J {
		focus-window-down
	}
	Mod+K {
		focus-window-up
	}
	Mod+L {
		focus-column-right
	}
	Mod+Left {
		focus-column-left
	}
	Mod+Minus {
		set-column-width "-10%"
	}
	Mod+N hotkey-overlay-title="Open Noctalia notifications" {
		spawn "noctalia" "msg" "panel-toggle" "notifications"
	}
	Mod+O {
		toggle-overview
	}
	Mod+Page_Down {
		focus-workspace-down
	}
	Mod+Page_Up {
		focus-workspace-up
	}
	Mod+Period {
		expel-window-from-column
	}
	Mod+Q {
		close-window
	}
	Mod+Space hotkey-overlay-title="Open Noctalia launcher" {
		spawn "noctalia" "msg" "panel-toggle" "launcher"
	}
	Mod+Return hotkey-overlay-title="Open a Terminal: Ghostty" {
		spawn "ghostty"
	}
	Mod+Right {
		focus-column-right
	}
	Mod+Shift+1 {
		move-column-to-workspace "browser"
	}
	Mod+Shift+2 {
		move-column-to-workspace "coding"
	}
	Mod+Shift+3 {
		move-column-to-workspace "herdr"
	}
	Mod+Shift+4 {
		move-column-to-workspace "extra"
	}
	Mod+Shift+5 {
		move-column-to-workspace "social"
	}
	Mod+Shift+6 {
		move-column-to-workspace "music"
	}
	Mod+Shift+7 {
		move-column-to-workspace 7
	}
	Mod+Shift+8 {
		move-column-to-workspace 8
	}
	Mod+Shift+9 {
		move-column-to-workspace 9
	}
	Mod+Shift+C hotkey-overlay-title="Color picker" {
		spawn "/home/piioni/.config/hypr/scripts/colorpicker.sh"
	}
	Mod+Shift+Ctrl+Down {
		move-column-to-monitor-down
	}
	Mod+Shift+Ctrl+H {
		move-column-to-monitor-left
	}
	Mod+Shift+Ctrl+J {
		move-column-to-monitor-down
	}
	Mod+Shift+Ctrl+K {
		move-column-to-monitor-up
	}
	Mod+Shift+Ctrl+L {
		move-column-to-monitor-right
	}
	Mod+Shift+Ctrl+Left {
		move-column-to-monitor-left
	}
	Mod+Shift+Ctrl+Right {
		move-column-to-monitor-right
	}
	Mod+Shift+Ctrl+Up {
		move-column-to-monitor-up
	}
	Mod+Ctrl+Down {
		focus-monitor-down
	}
	Mod+Shift+E {
		quit
	}
	Mod+Shift+Equal {
		set-window-height "+10%"
	}
	Mod+Shift+F {
		fullscreen-window
	}
	Mod+Ctrl+H {
		focus-monitor-left
	}
	Mod+Ctrl+J {
		focus-monitor-down
	}
	Mod+Ctrl+K {
		focus-monitor-up
	}
	Mod+Ctrl+L {
		focus-monitor-right
	}
	Mod+Ctrl+Left {
		focus-monitor-left
	}
	Mod+Shift+Minus {
		set-window-height "-10%"
	}
	Mod+Shift+Page_Down {
		move-workspace-down
	}
	Mod+Shift+Page_Up {
		move-workspace-up
	}
	Mod+Ctrl+Right {
		focus-monitor-right
	}
	Mod+Shift+T {
		toggle-window-rule-opacity
	}
	Mod+Ctrl+Up {
		focus-monitor-up
	}
	Mod+Shift+V {
		switch-focus-between-floating-and-tiling
	}
	Mod+Shift+WheelScrollDown {
		focus-column-right
	}
	Mod+Shift+WheelScrollUp {
		focus-column-left
	}
	Mod+U {
		focus-workspace-down
	}
	Mod+Up {
		focus-window-up
	}
	Mod+V {
		toggle-window-floating
	}
	Mod+W {
		toggle-column-tabbed-display
	}
	Mod+WheelScrollDown cooldown-ms=150 {
		focus-workspace-down
	}
	Mod+WheelScrollLeft {
		focus-column-left
	}
	Mod+WheelScrollRight {
		focus-column-right
	}
	Mod+WheelScrollUp cooldown-ms=150 {
		focus-workspace-up
	}
	XF86AudioLowerVolume allow-when-locked=true {
		spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%-"
	}
	XF86AudioMicMute allow-when-locked=true {
		spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"
	}
	XF86AudioMute allow-when-locked=true {
		spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
	}
	XF86AudioRaiseVolume allow-when-locked=true {
		spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"
	}
	XF86MonBrightnessDown allow-when-locked=true {
		spawn "brightnessctl" "--class=backlight" "set" "10%-"
	}
	XF86MonBrightnessUp allow-when-locked=true {
		spawn "brightnessctl" "--class=backlight" "set" "+10%"
	}
}


