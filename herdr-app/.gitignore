# Herdr rewrites most of this folder on every start; only personal files are versioned.
/*
!/.gitignore
!/keys.json
!/settings.json
!/layouts/
!/themes/
!/mods/

/layouts/*
!/layouts/piioni.json
!/layouts/piioni.svg

/themes/*
!/themes/catppuccin.json

/mods/*
!/mods/linear/
!/mods/prs/
!/mods/relevo/
!/mods/relevo-agents/
!/mods/piioni-changes/
!/mods/piioni-files/
!/mods/piioni-tabs/

# Written by gpui-shell into every mod folder.
gpui-kit.d.ts
jsconfig.json

# Python bytecode from the relevo hook and its test.
__pycache__/
