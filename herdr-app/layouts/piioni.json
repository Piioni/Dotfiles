{
  "id": "root",
  "type": "row",
  "preview": "layouts/piioni.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "accounts",
          "type": "block",
          "size": {
            "px": 104
          },
          "content": {
            "mod": "relevo",
            "props": {
              "role": "accounts"
            }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "relevo-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "resizable": false,
          "size": {
            "px": 42
          },
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "relevo-tabs"
              }
            },
            {
              "id": "inbox-button",
              "type": "block",
              "size": {
                "px": 92
              },
              "window_drag": true,
              "content": {
                "mod": "relevo",
                "props": {
                  "role": "inbox-button"
                }
              }
            },
            {
              "id": "tasks-button",
              "type": "block",
              "size": {
                "px": 78
              },
              "window_drag": true,
              "content": {
                "mod": "linear",
                "props": {
                  "button": true
                }
              }
            },
            {
              "id": "panel-buttons",
              "type": "block",
              "size": {
                "px": 158
              },
              "window_drag": true,
              "content": {
                "mod": "relevo-tabs",
                "props": {
                  "panels": true
                }
              }
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "size": {
                "px": 44
              },
              "window_drag": true,
              "content": {
                "mod": "relevo",
                "props": {
                  "role": "panel-toggle"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": false,
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-bar",
                  "type": "block",
                  "size": {
                    "px": 38
                  },
                  "content": {
                    "mod": "relevo",
                    "props": {
                      "role": "panel-bar"
                    }
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "inbox",
                  "children": [
                    {
                      "id": "inbox",
                      "type": "block",
                      "content": {
                        "mod": "relevo",
                        "props": {
                          "role": "inbox"
                        }
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "relevo-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "relevo-changes"
                      }
                    },
                    {
                      "id": "tasks",
                      "type": "block",
                      "content": {
                        "mod": "linear"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
