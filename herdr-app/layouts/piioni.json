{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "accounts",
          "type": "block",
          "content": {
            "mod": "relevo",
            "props": {
              "role": "accounts"
            }
          },
          "size": {
            "px": 128
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "relevo-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "ion-tabs"
              },
              "window_drag": true
            },
            {
              "id": "tasks-button",
              "type": "block",
              "content": {
                "mod": "tasks",
                "props": {
                  "button": true
                }
              },
              "size": {
                "px": 84
              },
              "window_drag": true
            },
            {
              "id": "issues-button",
              "type": "block",
              "content": {
                "mod": "linear",
                "props": {
                  "button": true
                }
              },
              "size": {
                "px": 78
              },
              "window_drag": true
            },
            {
              "id": "prs-button",
              "type": "block",
              "content": {
                "mod": "prs",
                "props": {
                  "button": true
                }
              },
              "size": {
                "px": 66
              },
              "window_drag": true
            },
            {
              "id": "panel-buttons",
              "type": "block",
              "content": {
                "mod": "ion-tabs",
                "props": {
                  "panels": true
                }
              },
              "size": {
                "px": 158
              },
              "window_drag": true
            },
            {
              "id": "panel-toggle",
              "type": "block",
              "content": {
                "mod": "relevo",
                "props": {
                  "role": "panel-toggle"
                }
              },
              "size": {
                "px": 44
              },
              "window_drag": true
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "column",
                      "children": [
                        {
                          "id": "files-bar",
                          "type": "block",
                          "content": {
                            "mod": "relevo",
                            "props": {
                              "role": "panel-bar"
                            }
                          },
                          "size": {
                            "px": 38
                          }
                        },
                        {
                          "id": "files-body",
                          "type": "block",
                          "content": {
                            "mod": "ion-files"
                          }
                        }
                      ]
                    },
                    {
                      "id": "changes",
                      "type": "column",
                      "children": [
                        {
                          "id": "changes-bar",
                          "type": "block",
                          "content": {
                            "mod": "relevo",
                            "props": {
                              "role": "panel-bar"
                            }
                          },
                          "size": {
                            "px": 38
                          }
                        },
                        {
                          "id": "changes-body",
                          "type": "block",
                          "content": {
                            "mod": "ion-changes"
                          }
                        }
                      ]
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "prs"
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "linear"
                      }
                    }
                  ],
                  "active": "issues"
                }
              ],
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/piioni.svg"
}
