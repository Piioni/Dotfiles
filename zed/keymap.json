[
  // ============================================================
  // Global (Workspace) — sin conflicto con vim
  // ============================================================
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-s": "workspace::Save"
    }
  },

  // ============================================================
  // Editor — copy/paste siempre disponible
  // ============================================================
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-c": "editor::Copy",
      "ctrl-shift-v": "editor::Paste"
    }
  },

  // ============================================================
  // Editor: space leader (normal + visual)
  // ============================================================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Toggles
      "space t": "terminal_panel::Toggle",
      "space u g": "project_panel::ToggleHideGitIgnore",
      "space h": "workspace::ToggleLeftDock",

      // Markdown
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",

      // Files / search / AI
      "space f p": "projects::OpenRecent",
      "space s b": "buffer_search::Deploy",
      "space a c": "agent::ToggleFocus",
      "space /": "pane::DeploySearch"
    }
  },

  // ============================================================
  // Editor: vim normal — comandos de edicion y navegacion
  // ============================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // Archivos y busqueda
      "space space": "file_finder::Toggle",
      "space e": "pane::RevealInProjectPanel",

      // Pane
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      // Terminal
      "ctrl-t": "workspace::NewTerminal",

      // LSP
      "space c a": "editor::ToggleCodeActions",
      "space c r": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "g t": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",

      // Git
      "space g s": "git_panel::ToggleFocus",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",

      // Comentarios (agregado a normal mode)
      "g c": "editor::ToggleComments",

      // Buffers
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem"
    }
  },

  // ============================================================
  // Editor: vim visual — solo lo que difiere de normal
  // ============================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "g c": "editor::ToggleComments"
    }
  },

  // ============================================================
  // Editor: vim insert
  // ============================================================
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },

  // ============================================================
  // VimControl: liberar space para vim (BUG FIX)
  // ============================================================
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null
    }
  },

  // ============================================================
  // Terminal
  // ============================================================
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // ============================================================
  // ProjectPanel — operaciones de archivo + navegacion
  // ============================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "q": "workspace::ToggleRightDock",
      "space space": "file_finder::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // ============================================================
  // GitPanel — navegacion de panes agregada
  // ============================================================
  {
    "context": "GitPanel",
    "bindings": {
      "q": "workspace::ToggleRightDock",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown"
    }
  },

  // ============================================================
  // Unbinds
  // ============================================================
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-g": "vim::ShowLocation"
    }
  }
]
